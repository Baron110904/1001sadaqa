{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    // Le cache de compilation vit dans dist/. `nest start` supprime ce dossier
    // au démarrage : si le cache restait à la racine, TypeScript croirait tout
    // déjà émis et n'écrirait rien, laissant `dist/main` introuvable.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  // Le seed vit dans prisma/ et n'est pas compilé : ts-node l'exécute
  // directement. L'inclure ici ferait sortir le build dans dist/src/.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
