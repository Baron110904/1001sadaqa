# ── Base de données ────────────────────────────────────────────────
# Le port 5434 correspond au mapping du docker-compose. Il évite les conflits
# avec un PostgreSQL local (5432) ou un autre projet (5433).
#
# 127.0.0.1 et non localhost : sous Windows, « localhost » résout d'abord en
# IPv6 (::1). Si un autre processus écoute sur [::1]:5434, la connexion part
# vers lui et échoue avec « Can't reach database server ». Fixer l'IPv4 ferme
# cette classe de panne.
DATABASE_URL="postgresql://sadaqa:sadaqa@127.0.0.1:5434/sadaqa?schema=public"

# Connexion directe, hors pool, utilisee uniquement par les migrations.
# En local il n y a pas de pool : la meme adresse convient.
# Sur Neon, prendre l adresse SANS « -pooler » dans son nom.
DIRECT_URL="postgresql://sadaqa:sadaqa@127.0.0.1:5434/sadaqa?schema=public"

# ── API ───────────────────────────────────────────────────────────
PORT=4100
NODE_ENV=development
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS="http://localhost:3100"

# ── Authentification ──────────────────────────────────────────────
# À remplacer impérativement en production (openssl rand -base64 48)
JWT_ACCESS_SECRET="dev-access-secret-a-remplacer"
JWT_REFRESH_SECRET="dev-refresh-secret-a-remplacer"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Compte administrateur créé par le seed
SEED_ADMIN_EMAIL="admin@1001sadaqa.com"
SEED_ADMIN_PASSWORD="Sadaqa2026!"

# ── Stockage médias (MinIO / S3) ──────────────────────────────────
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY="sadaqa"
S3_SECRET_KEY="sadaqa-minio"
S3_PUBLIC_URL="http://localhost:9000"

# ── Stockage en ligne (Cloudflare R2) ──
#
# Laissez ces trois lignes vides en local : MinIO garde un seau par usage et
# accepte qu'on lui pose une règle de lecture publique.
#
# Sur R2, en revanche, l'accès public s'ouvre depuis le tableau de bord et se
# publie **par seau** : on range donc tout dans un seau unique, les huit usages
# devenant des préfixes de clé. Les adresses des fichiers sont identiques dans
# les deux modes, si bien que la bascule ne demande aucune reprise de données.
#
# S3_REGION="auto"              # R2 refuse une requête signée pour une autre région
# S3_BUCKET="sadaqa-medias"     # vide = un seau par usage (MinIO)
# S3_SET_POLICY=false           # R2 n'implémente pas PutBucketPolicy

# ── Observabilité ─────────────────────────────────────────────────
SENTRY_DSN=""
