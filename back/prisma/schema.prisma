enum Role {
  ADMIN
  EDITOR
  CONTRIBUTOR
}

/// Les quatre états du §5.2. Chacun appelle un bouton d'action différent :
/// un projet réalisé invite à en soutenir un semblable, un projet à financer
/// invite à le financer.
enum ProjectStatus {
  REALISE
  EN_COURS
  A_FINANCER
  EN_PREPARATION
}

/// État d'avancement d'un programme, distinct de `isActive`.
///
/// `isActive` décide de la publication : un programme masqué ne doit pas
/// apparaître sur le site. L'état ci-dessous décrit où en est le programme, et
/// reste public dans les deux cas — c'est lui que filtre la page Programmes.
enum ProgramStatus {
  ACTIF
  EN_PREPARATION
}

