# URL de l'API NestJS.
# Côté serveur (Server Components, Server Actions) comme côté navigateur.
NEXT_PUBLIC_API_URL="http://localhost:4100/api/v1"

# URL publique du site, utilisée pour les métadonnées, le sitemap et Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# Hôte des médias téléversés, en production (sans protocole).
# Exemple : media.1001sadaqa.com
NEXT_PUBLIC_MEDIA_HOST=""
